    <string name="help_notifications">বিজ্ঞপ্তি আসছে না?</string>
    <string name="help_intro">কিছু ফোন ব্যাটারি বাঁচাতে পটভূমিতে অ্যাপ বন্ধ করে দেয়। অনুগ্রহ করে নিচের বিষয়গুলো দেখুন:</string>
    <string name="help_battery_title">ব্যাটারি অপ্টিমাইজেশন</string>
    <string name="help_battery_text">সেটিংস → অ্যাপস → নামাজের সময় → ব্যাটারি → \"সীমাহীন\" (বা \"অপ্টিমাইজ করবেন না\") বেছে নিন।</string>
    <string name="help_xiaomi_title">Xiaomi / Redmi / POCO</string>
    <string name="help_xiaomi_text">সিকিউরিটি → পারমিশন → অটোস্টার্ট → নামাজের সময়-এর জন্য চালু করুন। তারপর সেটিংস → অ্যাপস → নামাজের সময় → ব্যাটারি সেভার → \"কোনো বিধিনিষেধ নেই\"।</string>
    <string name="help_huawei_title">Huawei / Honor</string>
    <string name="help_huawei_text">সেটিংস → ব্যাটারি → অ্যাপ লঞ্চ → নামাজের সময় → ম্যানুয়ালি পরিচালনা করুন এবং অটো-লঞ্চ, সেকেন্ডারি লঞ্চ ও পটভূমিতে চালানো চালু করুন।</string>
    <string name="help_samsung_title">Samsung</string>
    <string name="help_samsung_text">সেটিংস → ব্যাটারি → পটভূমি ব্যবহারের সীমা → \"ঘুমন্ত অ্যাপ\" ও \"গভীর ঘুমন্ত অ্যাপ\" থেকে নামাজের সময় সরান।</string>
