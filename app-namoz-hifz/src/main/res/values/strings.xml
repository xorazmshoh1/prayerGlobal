    <string name="help_notifications">Notifications not arriving?</string>
    <string name="help_intro">Some phones stop apps in the background to save battery. Please check the following:</string>
    <string name="help_battery_title">Battery optimization</string>
    <string name="help_battery_text">Settings → Apps → Prayer Times → Battery → choose \"Unrestricted\" (or \"Don\'t optimize\").</string>
    <string name="help_xiaomi_title">Xiaomi / Redmi / POCO</string>
    <string name="help_xiaomi_text">Security → Permissions → Autostart → enable for Prayer Times. Then Settings → Apps → Prayer Times → Battery saver → \"No restrictions\".</string>
    <string name="help_huawei_title">Huawei / Honor</string>
    <string name="help_huawei_text">Settings → Battery → App launch → Prayer Times → manage manually and enable auto-launch, secondary launch and run in background.</string>
    <string name="help_samsung_title">Samsung</string>
    <string name="help_samsung_text">Settings → Battery → Background usage limits → remove Prayer Times from \"Sleeping apps\" and \"Deep sleeping apps\".</string>
